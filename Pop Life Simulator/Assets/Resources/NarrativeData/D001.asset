  description: Player arrives, Midori welcomes, explains shop basics.
  characterPortrait: {fileID: 21300000, guid: 966896e566969a341918b408a096a2c5, type: 3}
  characterName: Midori
  conversationType: 3
  narrativeSequence:
    sequenceID: SEQ001
    sequenceName: 
    rootSegment:
      segmentID: SEG01
      speakerName: 
      textContent: "\u2026You are here, sex expert."
      speakerPortrait: {fileID: 0}
      nextSegments:
      - segmentID: SEG02
        speakerName: 
        textContent: "What\u2019s that look? You were confident enough to accept
          my invite, after all."
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG03
          speakerName: 
          textContent: "[narrows eyes] The email. Titled Midori\u2019s Sex Toy Shop.
            And you wrote back, \u2018Yes, I would be honored to help operate the
            store.\u2019"
          speakerPortrait: {fileID: 0}
          nextSegments:
          - segmentID: SEG04
            speakerName: 
            textContent: "You don\u2019t remember\u2026 tch\u2026"
            speakerPortrait: {fileID: 0}
            nextSegments:
            - segmentID: SEG05
              speakerName: 
              textContent: "I don\u2019t have time to find another person before
                I leave the city."
              speakerPortrait: {fileID: 0}
              nextSegments:
              - segmentID: SEG06
                speakerName: 
                textContent: "Come on in. You\u2019re operating this store from now
                  on!"
                speakerPortrait: {fileID: 0}
                nextSegments: []
                isEndSegment: 1
                displayDuration: 0
              isEndSegment: 0
              displayDuration: 0
            isEndSegment: 0
