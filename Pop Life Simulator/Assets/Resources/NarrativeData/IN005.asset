  narrativeSequence:
    sequenceID: 
    sequenceName: 
    rootSegment:
      segmentID: SEG01
      speakerName: 
      textContent: 'It''s my partner''s birthday soon, and I''d like to get them
        something to wear. Can any of these lingeries be used more than once? '
      speakerPortrait: {fileID: 0}
      nextSegments:
      - segmentID: SEG02
        speakerName: 
        textContent: 'Vintage lingerie is made of delicate material and may tear
          in the wash. Sturdier lingerie can be washed with normal clothing. Leather
          should only be cleaned with skin safe disinfectant. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG06
          speakerName: 
          textContent: 'Thanks for the help! I''ll take a look. '
          speakerPortrait: {fileID: 0}
          nextSegments: []
          isEndSegment: 1
          displayDuration: 0
          isChoiceNode: 0
          endRewards:
          - type: 1
            rewardID: 
            amount: 5
            marker: 0
        isEndSegment: 0
        displayDuration: 0
        isChoiceNode: 0
        endRewards: []
      - segmentID: SEG03
        speakerName: 
        textContent: 'You should always throw lingerie away once it''s been used.
          The material can be broken down by fluids and sweat. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG05
          speakerName: 
          textContent: 'That''s unfortunate. I''ll try somewhere else then. '
          speakerPortrait: {fileID: 0}
          nextSegments: []
          isEndSegment: 1
          displayDuration: 0
          isChoiceNode: 0
          endRewards: []
        isEndSegment: 0
        displayDuration: 0
        isChoiceNode: 0
        endRewards: []
      - segmentID: SEG04
        speakerName: 
        textContent: 'We don''t have that in the store right now. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG07
          speakerName: 
          textContent: 'That''s unfortunate. I''ll try somewhere else then. '
          speakerPortrait: {fileID: 0}
