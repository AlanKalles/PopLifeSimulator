  narrativeSequence:
    sequenceID: 
    sequenceName: 
    rootSegment:
      segmentID: SEG01
      speakerName: 
      textContent: 'What''s the difference between oil based and water based lube? '
      speakerPortrait: {fileID: 0}
      nextSegments:
      - segmentID: SEG02
        speakerName: 
        textContent: 'Oil based lube is more slippery, but it can break down condom
          material. It''s better used for raw sex, while water based lube is safe
          for condom use. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG06
          speakerName: 
          textContent: That sounds like exactly what I need.
          speakerPortrait: {fileID: 0}
          nextSegments: []
          isEndSegment: 1
          displayDuration: 0
          isChoiceNode: 0
          endRewards:
          - type: 1
            rewardID: 
            amount: 2
            marker: 0
        isEndSegment: 0
        displayDuration: 0
        isChoiceNode: 0
        endRewards: []
      - segmentID: SEG03
        speakerName: 
        textContent: 'Water based lube is thicker than oil based lube, and can have
          a stronger flavor. Oil based lube is generally tasteless. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG05
          speakerName: 
          textContent: 'Are you sure? That doen''t sound right. '
          speakerPortrait: {fileID: 0}
          nextSegments: []
          isEndSegment: 1
          displayDuration: 0
          isChoiceNode: 0
          endRewards: []
        isEndSegment: 0
        displayDuration: 0
        isChoiceNode: 0
        endRewards: []
      - segmentID: SEG04
        speakerName: 
        textContent: 'Oil based lube is easier to alter with other effects, such
          as flavor or even making it glow. Water based lube can''t hold these additions. '
        speakerPortrait: {fileID: 0}
        nextSegments:
        - segmentID: SEG07
          speakerName: 
          textContent: 'Are you sure? That doen''t sound right. '
          speakerPortrait: {fileID: 0}
